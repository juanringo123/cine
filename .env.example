# Server
PORT=8080
REQUEST_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=1048576

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Dipakai untuk Auth Admin generateLink saat verifikasi OTP
SUPABASE_SERVICE_ROLE_KEY=
# Koneksi Postgres via pgx
DATABASE_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
MAX_DB_CONNS=10

# Webhook generic
WEBHOOK_SECRET=secret-bebas-anda
WEBHOOK_SIGNATURE_HEADER=X-Signature
WEBHOOK_PROVIDER=generic

# Gateway pembayaran (Midtrans Snap)
PAYMENT_GATEWAY=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_SANDBOX=true
INTERNAL_API_KEY=ganti-dengan-internal-api-key

# WhatsApp OTP — dev | twilio | meta
OTP_PROVIDER=dev
OTP_PEPPER=ganti-dengan-string-acak
OTP_TTL_SECONDS=300
# Twilio (jika OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta WhatsApp Cloud API (jika OTP_PROVIDER=meta)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# QR tiket
TICKET_QR_BASE_URL=https://cine.example
QR_SIZE=512
