NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL Go API (lokal: http://localhost:8080; produksi/Vercel: isi dengan URL publik Go API, mis. https://api.domain.com atau URL ngrok)
# API_URL bersifat server-only (prioritas utama di Route Handler); NEXT_PUBLIC_API_URL sebagai fallback.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-only, harus sama dengan INTERNAL_API_KEY di Go API
INTERNAL_API_KEY=ganti-dengan-internal-api-key

# Proteksi endpoint simulasi pembayaran QRIS (POST /api/simulasi-bayar/[orderId])
# Aktif secara default dengan proteksi token HMAC (?t=...); set "false" untuk menonaktifkan endpoint dengan HTTP 403.
NEXT_PUBLIC_DEMO_PAYMENT=true
# Opsional: secret khusus penandatanganan token X-Simulasi-Token (jika kosong, memakai INTERNAL_API_KEY / SUPABASE_SERVICE_ROLE_KEY)
# SIMULASI_PAYMENT_SECRET=ganti-dengan-string-acak

# Opsional: URL publik untuk link QR Dummy QRIS (mis. http://192.168.1.3:3100 atau URL Ngrok).
# Jika dikosongkan, sistem otomatis mendeteksi IP LAN/Wi-Fi atau host request.
# NEXT_PUBLIC_APP_URL=http://192.168.1.3:3100

# Opsional: Google Gemini API Key untuk fitur asisten rekomendasi film (CINÉ AI).
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
